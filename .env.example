# ---------------------------------------------------------------------------
# ExampleLab — template for the .env of one environment.
#
# This file is committed WITHOUT real values. The real .env lives ONLY on the
# server in /opt/examplelab/staging or /opt/examplelab/production, owned by
# root:beyondles-dev with mode 660. It is never committed.
#
# Production and staging have SEPARATE values: own project name, own port,
# own database password.
# ---------------------------------------------------------------------------

# Separates the two environments in Docker (volumes, networks, container names).
COMPOSE_PROJECT_NAME=examplelab-staging

# Port on the server, bound to 127.0.0.1. Public access only via the
# Cloudflare tunnel. Production even, staging plus one.
APP_PORT=3391

# Database in its own container. New password per environment.
POSTGRES_USER=examplelab
POSTGRES_DB=examplelab
POSTGRES_PASSWORD=
# Connection pool size (optional; empty = default 25).
DATABASE_POOL_MAX=

# Local development only: DATABASE_URL for the Prisma CLI and `next dev`.
# On the server Compose builds it from the POSTGRES_* values above.
# DATABASE_URL=postgresql://examplelab:secret@localhost:5432/examplelab

# Sign-in: the Lab asks the Suite, it verifies nothing itself. Each
# environment talks to ITS OWN Suite — staging to suite-staging, production
# to beyondles.ai. Leaving this out is not "use the default": the stack
# refuses to start without it, because a missing line would otherwise sign
# staging users in against the production Suite.
NEXT_PUBLIC_PLATFORM_URL=https://suite-staging.beyondles.ai

# This environment's own public address (used for the login callback).
NEXT_PUBLIC_APP_URL=https://examplelab-staging.beyondles.ai

# ---------------------------------------------------------------------------
# Platform door (mandatory). AI only through POST /api/llm/complete, mail only
# through POST /api/mail/send of the platform API, access through
# /api/access/*. No provider key (ANTHROPIC_API_KEY, OPENAI_API_KEY,
# GOOGLE_*_API_KEY, MISTRAL_API_KEY, RESEND_API_KEY, SMTP_*) in a Lab, ever.
# Keys come from Bitwarden "Beyondles Infrastruktur".
# ---------------------------------------------------------------------------
# Staging https://api-staging.beyondles.ai, production https://api.beyondles.ai
# (until api.beyondles.ai is handed over: https://platform.beyondles.ai).
PLATFORM_API_URL=https://api-staging.beyondles.ai
# The Lab's OWN service key (platform table service_keys, one per environment).
# The key's name MUST equal the Lab key ("examplelab").
PLATFORM_API_KEY=
# On-behalf tokens at the tool door (/api/mcp, /api/v1): the issuer this
# environment accepts (beyondles-platform:staging or beyondles-platform:production).
# Empty = tokens answer 503, x-api-key keeps working.
ON_BEHALF_ISSUER=
# What the platform presents when it calls GET /api/platform/export.
PLATFORM_EXPORT_KEY=

# MCP over HTTP: base URL for the self-call to /api/v1. Empty = normal case.
MCP_SELF_BASE_URL=

# ---------------------------------------------------------------------------
# JWT_SECRET and ALLOW_LOCAL_JWT are deliberately NOT set here.
# The platform's signing secret never lives on a Lab server. If JWT_SECRET is
# set, the Lab verifies sessions itself and could forge them. It is allowed
# for CI and local development only, together with ALLOW_LOCAL_JWT=true, and
# a production process refuses to start when it finds it (src/lib/jwt-guard.ts).
# Check: docker exec examplelab-production-app-1 printenv JWT_SECRET ALLOW_LOCAL_JWT → empty
# Local development without a Suite: set JWT_SECRET=<any string> and
# ALLOW_LOCAL_JWT=true, then mint a cookie with `node scripts/dev-login.mjs`.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Only if the Lab really needs it (answered in phase 0 of /lab-pipeline):
# ---------------------------------------------------------------------------
# File storage. ALWAYS outside the repo folder, or a deploy deletes the data.
# Mount as a volume and add to the backup.
# STORAGE_DIR=/opt/examplelab/data/production

# Tenant and member deletion for the platform (DELETE /api/platform/organisation,
# DELETE /api/platform/member). Its own key, never the export key. Empty = route closed (503).
PLATFORM_DELETE_KEY=
